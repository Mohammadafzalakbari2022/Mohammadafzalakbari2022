      "direction": "topStartToBottomEnd",
      "stops": [
        { "color": "scheme.primary", "alpha": 1.0 },
        { "color": "scheme.primary", "alpha": 0.82 },
        { "color": "scheme.secondary", "alpha": 0.9 }
      ]
    },
    "heroCardOrder": {
      "direction": "topStartToBottomEnd",
      "stops": [
        { "color": "statusColor", "alpha": 0.14 },
        { "color": "scheme.primaryContainer", "alpha": 0.35 }
      ]
    },
    "heroCardCustomer": {
      "direction": "topStartToBottomEnd",
      "stops": [
        { "color": "scheme.secondary", "alpha": 0.12 },
        { "color": "scheme.primaryContainer", "alpha": 0.35 }
      ]
    },
    "dashboardIncomeBar": {
      "direction": "bottomToTop",
      "colors": ["scheme.secondary", "scheme.secondaryContainer"]
    },
    "loginLogoShadow": {
      "color": "scheme.primary",
      "alpha": 0.18,
      "blurRadius": 28,
      "offsetY": 10
    }
