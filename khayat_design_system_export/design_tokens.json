      "foreground": "actions.onCancelContainer"
    },
    "fab": {
      "background": "actions.add",
      "foreground": "actions.onAdd",
      "radius": 16
    },
    "variants": ["primary", "add", "edit", "delete", "cancel", "warning", "payment"]
  },
  "inputStyles": {
    "filled": true,
    "fillColorLight": "surfaceContainerLowest",
    "fillColorDark": "surfaceContainerLow",
    "radius": 12,
    "labelColor": "onSurfaceVariant",
    "hintAlpha": 0.85,
    "ltrFields": {
      "textDirection": "ltr",
      "textAlign": "left",
      "digitPattern": "Western + Persian + Arabic-Indic numerals"
    }
  },
  "cardStyles": {
    "elevation": 0,
    "color": "surfaceContainerLowest",
    "radius": 16,
    "margin": 0,
    "clipBehavior": "antiAlias",
    "border": "outlineVariant @ 0.6 alpha"
  },
  "listStyles": {
    "selectionAnimationMs": 220,
    "selectionCurve": "easeOutCubic",
    "tileRadius": 14,
    "tileBackground": "surfaceContainerLow",
    "selectedBackground": "primaryContainer @ 0.42 alpha",
    "nameBadgeBackground": "surfaceContainerHigh"
  },
  "navigationStyles": {
    "bottomNavigationBar": {
      "widget": "NavigationBar",
      "height": 72,
      "backgroundColor": "surfaceContainerLowest",
      "surfaceTint": "transparent",
      "indicatorColor": "primaryContainer",
      "selectedLabelWeight": 700,
      "unselectedLabelWeight": 500
    },
    "appBar": {
      "centerTitle": false,
      "backgroundColor": "surfaceContainerLow",
      "foregroundColor": "onSurface",
      "leadingDashboardIconColor": "primary"
    },
    "drawer": {
      "widthPercent": 0.92,
      "backgroundColor": "surface"
    },
    "settingsSection": {
      "radius": 16,
      "borderWidth": 1.5,
      "borderColor": "primary @ 0.38 alpha"
    }
  },
  "breakpoints": {
    "note": "No formal responsive framework. Ad-hoc MediaQuery thresholds.",
    "drawerWidth": "92% of screen width",
    "catalogGridCrossAxisCount": {
      "widthLessThan360": 2,
      "widthLessThan600": 3,
      "default": 4
    },
    "styleFigureGridCrossAxisCount": {
      "widthLessThan400": 2,
      "widthLessThan700": 3,
      "default": 4
    },
    "bottomSheetHeight": {
      "customerProfileSheet": "88% of screen height",
      "developerCodesPreview": "30% of screen height"
    },
    "primaryTarget": "mobile phone portrait; tablet/desktop use same layouts with wider grids"
  },
  "lightTheme": {
    "builder": "buildPrideLightTheme()",
    "colorSchemeSource": "ColorScheme.fromSeed(seed: #7C3AED, brightness: light, dynamicSchemeVariant: vibrant) + manual overrides",
    "scaffoldBackground": "surface",
    "extensions": ["PrideActionColors.light"]
  },
  "darkTheme": {
    "builder": "buildPrideDarkTheme()",
    "colorSchemeSource": "ColorScheme.fromSeed(seed: #7C3AED, brightness: dark, dynamicSchemeVariant: vibrant) + manual overrides",
    "scaffoldBackground": "surface",
    "extensions": ["PrideActionColors.dark"]
  },
  "systemTheme": {
    "defaultMode": "ThemeMode.system",
    "persistenceKey": "pride_theme_mode",
    "provider": "themeModeProvider (Riverpod StateProvider)",
    "uiControl": "SegmentedButton<ThemeMode> on settings appearance screen"
  }
}
