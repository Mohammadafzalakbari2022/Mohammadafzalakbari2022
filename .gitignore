# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/Pride-android.apk
/Khayat-android.apk
/Khayat-release.aab
/Khayat-windows-x64.zip
/Khayat-windows.msix
*.msix

# Store-folder release binaries (markdown/listings in those folders stay tracked)
play store ready files/*.apk
play store ready files/*.aab
microsoft store ready files/*.zip
microsoft store ready files/*.cer
/config/msix_publisher.txt
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle / Kotlin local caches (do not commit)
/android/.gradle/
/android/.kotlin/

# Path-override plugins under `third_party/` (e.g. isar_flutter_libs) may create their
# own Gradle cache when Android Studio / Gradle syncs that subproject — do not commit.
third_party/**/.gradle/

# Local env & signing (never commit secrets)
.env
.env.*
!.env.example
config/dart_defines_secrets.json
android/key.properties
*.jks
*.keystore
*.pfx
*.p12

# FVM (optional local SDK pin)
.fvm/

# Local style-figure source folder (canonical copies live in assets/style_figures/)
style figures/

# Windows junk
Thumbs.db
ehthumbs.db
Desktop.ini

# NestJS API (`api/`)
api/node_modules/
api/node_modules/.prisma/
api/dist/
api/build/
api/coverage/

# Local IDE / agent tooling (machine-specific; do not commit)
.cursor/mcp.json
.agents/
skills-lock.json
.vercel
.env*
/external/
