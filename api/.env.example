# Copy to `.env` for local API runs.
#
# Postgres URL — pick one:
# - Docker: from repo root run `docker compose up -d` only after Docker Desktop is
#   **running** (Windows error on `dockerDesktopLinuxEngine` pipe = Desktop off).
# - No Docker: install PostgreSQL locally or use Supabase/hosted URI here instead.
#
# If `npx prisma migrate deploy` fails with **P1000 Authentication failed**, your URL does
# not match this server. With Docker Compose here, use **port 5433** (see DATABASE_URL below).
# If you still use `...:5432/...` while Windows PostgreSQL is on 5432, you connect to the
# wrong server — `pride` / `pride` will never work there.
# Typical fixes:
# - Local installer default superuser: use `postgres` + the password you set at install:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/pride_api
#   (create DB first: `CREATE DATABASE pride_api;` in pgAdmin or psql)
# - Or create a matching role (run as superuser in psql / pgAdmin):
#   CREATE USER pride WITH PASSWORD 'pride';
#   CREATE DATABASE pride_api OWNER pride;
# Must match `docker-compose.yml` host port (5433 → container 5432).
DATABASE_URL=postgresql://pride:pride@127.0.0.1:5433/pride_api
#
# Supabase (hosted): Project Settings → Database → URI (use **Direct connection**
# for this Nest API on Render so `prisma migrate deploy` and the app share one URL;
# append `?sslmode=require` if the host does not already include it).
# Example shape (password from Supabase, not the anon key):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=pride-dev-jwt-secret-min-32-characters-change-me
# Optional: PRIDE_AUTH_SEED=shop_id|username|password
# Optional: PRIDE_DEVELOPER_IDS=comma-separated shop_users.id (same as JWT sub)
# Optional: PRIDE_LEGACY_REDEEM_CODES=pilot-2026,other-dev-codes
# Public catalog stub: when set to "false", Flutter default catalog sharing is off.
# CATALOG_SHARING_DEFAULT=true
