# Copy to `.env` (gitignored) — see instructions below for this project's hosted Supabase.
#
# Prisma CLI looks for `./prisma/schema.prisma` relative to the current directory.
# From repo root, `npx prisma migrate deploy` fails with "Could not find Prisma Schema".
# Always run Prisma from this folder, e.g. `cd api` then `npx prisma migrate deploy`.
#
# ── Hosted Supabase (production) ─────────────────────────────────────────────
# Project ref: dssnxgndsolxphhyjcql
# Password:    Princekhan@2026 (URL-encode @ as %40 in the connection string)
#
# Direct connection (for Prisma migrations — port 5432):
#   DATABASE_URL=postgresql://postgres.dssnxgndsolxphhyjcql:Princekhan%402026@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Pooler / transaction mode (for runtime — port 6543, add ?pgbouncer=true):
#   DATABASE_URL=postgresql://postgres.dssnxgndsolxphhyjcql:Princekhan%402026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# Run `npx prisma migrate deploy` BEFORE starting the API so the schema is applied.
#
# ── Local Docker ─────────────────────────────────────────────────────────────
# From repo root run `docker compose up -d` (Docker Desktop must be running).
# Uses port **5433** (host) → 5432 (container) to avoid conflicting with a local
# PostgreSQL install. Default creds: pride / pride.
#   DATABASE_URL=postgresql://pride:pride@127.0.0.1:5433/pride_api
DATABASE_URL=postgresql://postgres.dssnxgndsolxphhyjcql:Princekhan%402026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
JWT_SECRET=pride-dev-jwt-secret-min-32-characters-change-me
# Optional: PRIDE_AUTH_SEED=shop_id|username|password  OR  shop_id|shop_name|username|password
# Optional: PRIDE_OPERATOR_SEED=shop_id|username|password — non-owner user after PRIDE_AUTH_SEED (same shop_id).
# Optional: PRIDE_DEVELOPER_USERS=shop_id|username,other_shop|other — developer portal by login (comma-separated).
# Optional: PRIDE_DEVELOPER_IDS=comma-separated shop_users.id (same as JWT sub); can combine with PRIDE_DEVELOPER_USERS.
# Optional: PRIDE_LEGACY_REDEEM_CODES=pilot-2026,other-dev-codes
# Public catalog stub: when set to "false", Flutter default catalog sharing is off.
# CATALOG_SHARING_DEFAULT=true
#
# Optional (Render / production): Firebase service account JSON for FCM push (one line).
# If unset, the API starts normally; only push delivery is disabled.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
