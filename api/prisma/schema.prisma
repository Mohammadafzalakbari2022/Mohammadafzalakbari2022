generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                   String             @id
  name                 String
  createdAt            DateTime           @default(now()) @map("created_at")
  lastMutationRevision Int                @default(0) @map("last_mutation_revision")
  disabledAt           DateTime?          @map("disabled_at")

  users                  ShopUser[]
  license                ShopLicense?
  syncMutations          ShopSyncMutation[]
  licenseExpiryPushDays  LicenseExpiryPushDay[]

  @@map("shops")
}

/// Append-only server log of accepted sync mutations (`plan-03` / `plan-04`).
model ShopSyncMutation {
  id              String   @id @default(uuid())
  shopId          String   @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  revision        Int
  internalId      String   @map("internal_id")
  entityType      String   @map("entity_type")
  operation       String   @map("operation")
  clientUpdatedAt DateTime @map("client_updated_at")
  payload         Json?    @map("payload")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([shopId, revision])
  @@index([shopId, revision])
  @@map("shop_sync_mutations")
}

model ShopUser {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  username     String
  passwordHash String    @map("password_hash") @db.VarChar(64)
  isShopOwner  Boolean   @map("is_shop_owner")
  deletedAt    DateTime? @map("deleted_at")

  @@index([shopId, username])
  @@map("shop_users")
}

model ShopLicense {
  shopId         String    @id @map("shop_id")
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  statusStored   String    @map("status")
  expiresAt      DateTime  @map("expires_at")
  trialStartedAt DateTime? @map("trial_started_at")

  @@map("shop_licenses")
}

/// User-initiated password reset queue for developer/support (`plan-18`).
model PasswordResetRequest {
  id         String    @id @default(uuid())
  shopId     String    @map("shop_id")
  userId     String    @map("user_id")
  username   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([shopId, status])
  @@map("password_reset_requests")
}

/// FCM (or other) device token per shop user — future push delivery (`plan-22`).
model ShopPushToken {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  userId    String   @map("user_id")
  platform  String
  token     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, userId, platform])
  @@map("shop_push_tokens")
}

/// One row per shop per UTC calendar day — avoids duplicate license-expiry FCM reminders (`plan-22`).
model LicenseExpiryPushDay {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayUtc    String   @map("day_utc") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([shopId, dayUtc])
  @@index([shopId])
  @@map("license_expiry_push_days")
}

/// Developer-created license activation strings (`plan-18` / `plan-06`).
model ActivationCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  status             String    @default("active")
  maxUses            Int       @default(1) @map("max_uses")
  usesCount          Int       @default(0) @map("uses_count")
  planDays           Int       @default(365) @map("plan_days")
  expiresAt          DateTime? @map("expires_at")
  assignedShopId     String?   @map("assigned_shop_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  redeemedAt         DateTime? @map("redeemed_at")
  lastRedeemedShopId String?   @map("last_redeemed_shop_id")

  @@map("activation_codes")
}

/// Developer / admin actions (`plan-18`).
model AdminAuditLog {
  id            String   @id @default(uuid())
  developerSub  String   @map("developer_sub")
  action        String
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_logs")
}
