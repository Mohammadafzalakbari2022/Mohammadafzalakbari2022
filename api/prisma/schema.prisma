generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                   String             @id
  name                 String
  /// E.164-ish digits for support contact (developer portal only).
  contactWhatsapp      String?            @map("contact_whatsapp")
  contactEmail         String?            @map("contact_email")
  contactAddress       String?            @map("contact_address")
  createdAt            DateTime           @default(now()) @map("created_at")
  lastMutationRevision Int                @default(0) @map("last_mutation_revision")
  disabledAt           DateTime?          @map("disabled_at")
  /// Paid-shop seat cap (trial always uses fixed limit). Admin-adjustable 1–20 (`plan-04`).
  maxUsers             Int                @default(5) @map("max_users")

  users                  ShopUser[]
  license                ShopLicense?
  syncMutations          ShopSyncMutation[]
  licenseExpiryPushDays  LicenseExpiryPushDay[]
  catalogSettings        ShopCatalogSettings?
  publicCatalogEntries   PublicCatalogEntry[]

  @@map("shops")
}

/// Append-only server log of accepted sync mutations (`plan-03` / `plan-04`).
model ShopSyncMutation {
  id              String   @id @default(uuid())
  shopId          String   @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  revision        Int
  internalId      String   @map("internal_id")
  entityType      String   @map("entity_type")
  operation       String   @map("operation")
  clientUpdatedAt DateTime @map("client_updated_at")
  payload         Json?    @map("payload")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([shopId, revision])
  @@index([shopId, revision])
  @@map("shop_sync_mutations")
}

model ShopUser {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  username     String
  passwordHash String    @map("password_hash") @db.VarChar(64)
  isShopOwner  Boolean   @map("is_shop_owner")
  deletedAt    DateTime? @map("deleted_at")

  @@index([shopId, username])
  @@map("shop_users")
}

model ShopLicense {
  shopId         String    @id @map("shop_id")
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  statusStored   String    @map("status")
  expiresAt      DateTime  @map("expires_at")
  trialStartedAt DateTime? @map("trial_started_at")

  @@map("shop_licenses")
}

/// User-initiated password reset queue for developer/support (`plan-18`).
model PasswordResetRequest {
  id         String    @id @default(uuid())
  shopId     String    @map("shop_id")
  userId     String    @map("user_id")
  username   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([shopId, status])
  @@map("password_reset_requests")
}

/// FCM (or other) device token per shop user — future push delivery (`plan-22`).
model ShopPushToken {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  userId    String   @map("user_id")
  platform  String
  token     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, userId, platform])
  @@map("shop_push_tokens")
}

/// One row per shop per UTC calendar day — avoids duplicate license-expiry FCM reminders (`plan-22`).
model LicenseExpiryPushDay {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayUtc    String   @map("day_utc") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([shopId, dayUtc])
  @@index([shopId])
  @@map("license_expiry_push_days")
}

/// Developer-created license activation strings (`plan-18` / `plan-06`).
model ActivationCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  status             String    @default("active")
  maxUses            Int       @default(1) @map("max_uses")
  usesCount          Int       @default(0) @map("uses_count")
  planDays           Int       @default(365) @map("plan_days")
  expiresAt          DateTime? @map("expires_at")
  assignedShopId     String?   @map("assigned_shop_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  redeemedAt         DateTime? @map("redeemed_at")
  lastRedeemedShopId String?   @map("last_redeemed_shop_id")

  paymentClaims SubscriptionPaymentClaim[]

  @@map("activation_codes")
}

/// Global Hesab Pay / subscription payment instructions (singleton `default`).
model SubscriptionBillingConfig {
  id                      String   @id
  hesabPayAccountName     String?  @map("hesab_pay_account_name")
  hesabPayAccountNumber   String?  @map("hesab_pay_account_number")
  hesabPayMerchantId      String?  @map("hesab_pay_merchant_id")
  hesabPayPaymentLink     String?  @map("hesab_pay_payment_link")
  hesabPayPaymentLinkLabel Json    @default("{}") @map("hesab_pay_payment_link_label")
  price1YearAfn           Int?     @map("price_1_year_afn")
  price2YearAfn           Int?     @map("price_2_year_afn")
  priceLifetimeAfn        Int?     @map("price_lifetime_afn")
  paymentSteps            Json     @default("{}") @map("payment_steps")
  activationDeliverySteps Json     @default("{}") @map("activation_delivery_steps")
  cashPaymentNote         Json     @default("{}") @map("cash_payment_note")
  whatsappE164            String?  @map("whatsapp_e164")
  telegramHandle          String?  @map("telegram_handle")
  directPhoneE164         String?  @map("direct_phone_e164")
  settingsImage           Bytes?   @map("settings_image")
  settingsImageMimeType   String?  @map("settings_image_mime_type")
  isPublished             Boolean  @default(false) @map("is_published")
  updatedAt               DateTime @updatedAt @map("updated_at")
  updatedByDeveloperSub   String?  @map("updated_by_developer_sub")

  @@map("subscription_billing_config")
}

/// Global developer contact info + help video link (singleton `default`).
model AppSupportConfig {
  id                   String   @id
  developerName        String?  @map("developer_name")
  developerTitle       String?  @map("developer_title")
  developerBio         String?  @map("developer_bio")
  supportEmail         String?  @map("support_email")
  supportPhone         String?  @map("support_phone")
  supportWhatsapp      String?  @map("support_whatsapp")
  helpVideoUrl         String?  @map("help_video_url")
  isPublished          Boolean  @default(false) @map("is_published")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedByDeveloperSub String? @map("updated_by_developer_sub")

  @@map("app_support_config")
}

/// Shop owner-submitted Hesab Pay payment proof awaiting developer review.
model SubscriptionPaymentClaim {
  id                     String          @id @default(uuid())
  shopId                 String          @map("shop_id")
  submittedByUserId      String          @map("submitted_by_user_id")
  planTier               String          @map("plan_tier")
  amountAfn              Int             @map("amount_afn")
  transactionId          String          @unique @map("transaction_id")
  payerPhone             String?         @map("payer_phone")
  notes                  String?         @map("notes")
  status                 String          @default("pending")
  reviewedAt             DateTime?       @map("reviewed_at")
  reviewedByDeveloperSub String?         @map("reviewed_by_developer_sub")
  reviewNotes            String?         @map("review_notes")
  linkedActivationCodeId String?         @map("linked_activation_code_id")
  linkedActivationCode   ActivationCode? @relation(fields: [linkedActivationCodeId], references: [id], onDelete: SetNull)
  createdAt              DateTime        @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([shopId, createdAt])
  @@map("subscription_payment_claims")
}

/// Developer / admin actions (`plan-18`).
model AdminAuditLog {
  id            String   @id @default(uuid())
  developerSub  String   @map("developer_sub")
  action        String
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Per-shop catalog sharing opt-in (`plan-14`).
model ShopCatalogSettings {
  shopId         String   @id @map("shop_id")
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sharingEnabled Boolean  @default(false) @map("sharing_enabled")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("shop_catalog_settings")
}

/// Public catalog metadata index — no image binaries (`plan-14`).
model PublicCatalogEntry {
  id               String    @id @default(uuid())
  shopId           String    @map("shop_id")
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  internalId       String    @map("internal_id")
  designName       String    @map("design_name")
  designerShopName String    @map("designer_shop_name")
  notes            String?
  sharedAt         DateTime  @default(now()) @map("shared_at")
  unpublishedAt    DateTime? @map("unpublished_at")

  @@unique([shopId, internalId])
  @@index([sharedAt])
  @@map("public_catalog_entries")
}

/// WebRTC signaling inbox (`plan-14`); payloads are offer/answer/ICE/chunks only.
model P2pSignalMessage {
  id          String    @id @default(uuid())
  toShopId    String    @map("to_shop_id")
  fromShopId  String    @map("from_shop_id")
  sessionId   String    @map("session_id")
  payloadType String    @map("payload_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  consumedAt  DateTime? @map("consumed_at")

  @@index([toShopId, consumedAt])
  @@index([sessionId])
  @@map("p2p_signal_messages")
}
